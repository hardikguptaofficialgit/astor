# Meta Model API Key (required for streaming chat replies)
META_API_KEY=

# Meta Model API Base URL (default: https://api.meta.ai/v1)
META_BASE_URL=https://api.meta.ai/v1

# Model Name for Astor (default: muse-spark-1.3)
ASTOR_MODEL=muse-spark-1.3

# Tavily API Key for real-time web search (used in later milestones)
TAVILY_API_KEY=

# Supermemory API Key for persistent conversational memory (used in later milestones)
SUPERMEMORY_API_KEY=
