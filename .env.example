# ==============================================================================
# Astor Environment Configuration
# ==============================================================================

# Meta Model API Key (required for streaming chat completions)
META_API_KEY=

# Meta Model API Base URL (default: https://api.meta.ai/v1)
META_BASE_URL=https://api.meta.ai/v1

# Model ID for Astor (default: muse-spark-1.3)
ASTOR_MODEL=muse-spark-1.3

# Tavily API Key for real-time web search (required for web_search tool in M2+)
# Basic search costs 1 credit per query; results are cached in SQLite search_cache
TAVILY_API_KEY=

# Supermemory API Key for persistent semantic memory (used in M3+)
SUPERMEMORY_API_KEY=

# Optional daily token budget limit to safeguard Meta credits
# ASTOR_DAILY_TOKEN_BUDGET=100000

# Optional search cache TTL override in seconds (default: 86400 for general, 3600 for news/finance)
# ASTOR_SEARCH_CACHE_TTL_GENERAL=86400
